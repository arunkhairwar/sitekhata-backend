generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           Role
  mobile         String   @unique
  address        Address? @relation(fields: [addressId], references: [id])
  createdAt      DateTime @default(now())
  addressId      String?
  createdClients Client[]
  createdSites   Site[]
}

enum Role {
  CONTRACTOR
  WORKER
}

model Address {
  id           String   @id @default(uuid())
  addressLine1 String?
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String
  User         User[]
  clients      Client[]
  sites        Site[]
}

//======================= Client =======================

model Client {
  id          String   @id @default(uuid())
  name        String
  mobile      String   @unique
  address     Address? @relation(fields: [addressId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  addressId   String?
}

model Site {
  id          String   @id @default(uuid())
  name        String
  mobile      String   @unique
  address     Address? @relation(fields: [addressId], references: [id])
  addressId   String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}
