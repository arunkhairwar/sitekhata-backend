model Site {
    id              String        @id @default(ulid())
    name            String
    estimatedBudget Int?
    startDate       DateTime?
    expectedEndDate DateTime?
    clientId        String
    client          Client        @relation(fields: [clientId], references: [id])
    profile         SiteProfile?
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @default(now()) @updatedAt()
    @@index([clientId])
    @@map("sites")
}
