model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           Role
  mobile         String   @unique
  address        Address? @relation(fields: [addressId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt()
  addressId      String?
  createdClients Client[]
  createdSites   Site[]
}